#!/bin/sh
set -eu
if [ "${1:-}" = configure ]; then
  service=com.idonamaan.ieb.process-reader
  if /var/jb/usr/bin/launchctl print "system/$service" >/dev/null 2>&1; then
    /var/jb/usr/bin/launchctl bootout "system/$service"
  fi
  /var/jb/usr/bin/launchctl bootstrap system "/var/jb/Library/LaunchDaemons/$service.plist"
  /var/jb/usr/libexec/ieb-process-reader --check-service
fi
